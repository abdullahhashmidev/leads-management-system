# Copy to .env.local and fill every value. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=your-model-name
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=at-least-32-random-characters-here-0123456789
# Optional
NTFY_TOPIC=your-private-ntfy-topic
NEXT_PUBLIC_WHATSAPP_NUMBER=923000000000
APP_URL=http://localhost:3000
CHAT_ENABLED=true
CHAT_LLM_PER_MIN=5
CHAT_DAILY_LLM_LIMIT=100
